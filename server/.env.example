# Production template. Keep real credentials outside source control.
DAILYTELLY_ENV=production
DAILYTELLY_PUBLIC_URL=https://thedailytelly.com
DAILYTELLY_OWNER_EMAILS=hello@thedailytelly.com
DAILYTELLY_DATA=/data
DAILYTELLY_MAIL_MODE=smtp
# Before SMTP is available, use disabled to close public registration securely.
# Issue a private owner link with scripts/owner-access.py in that environment.
DAILYTELLY_MAIL_FROM=hello@thedailytelly.com
DAILYTELLY_SMTP_HOST=
DAILYTELLY_SMTP_PORT=587
DAILYTELLY_SMTP_USER=
DAILYTELLY_SMTP_PASSWORD=
DAILYTELLY_EMAIL_HOURLY_BUDGET=100
DAILYTELLY_EMAIL_DAILY_BUDGET=500
DAILYTELLY_CONTACT_EMAIL=hello@thedailytelly.com
DAILYTELLY_CONTACT_HOURLY_BUDGET=10
DAILYTELLY_CONTACT_DAILY_BUDGET=30
# Optional override; Resend SMTP password can also supply the sending-only API key.
DAILYTELLY_RESEND_SENDING_KEY=
# Optional Resend receiving integration; keep credentials and destination private.
DAILYTELLY_RESEND_RECEIVING_KEY=
DAILYTELLY_RESEND_WEBHOOK_SECRET=
DAILYTELLY_INBOUND_ADDRESS=hello@thedailytelly.com
DAILYTELLY_INBOUND_FORWARD_TO=
YOUTUBE_API_KEY=
DAILYTELLY_YOUTUBE_DAILY_BUDGET=9000
DAILYTELLY_YOUTUBE_SEARCH_BUDGET=90
# Optional signing key; otherwise generated in the data directory. Keep persistent.
# DAILYTELLY_SECRET=
DAILYTELLY_PUSHOVER_USER=
DAILYTELLY_PUSHOVER_TOKEN=
DAILYTELLY_ALERT_CPU=85
DAILYTELLY_ALERT_MEMORY=85
DAILYTELLY_ALERT_DISK=90
# For containers, match these to the actual resource limits; omit for host metrics.
# DAILYTELLY_CPU_LIMIT=1
# DAILYTELLY_MEMORY_LIMIT_MB=1024
